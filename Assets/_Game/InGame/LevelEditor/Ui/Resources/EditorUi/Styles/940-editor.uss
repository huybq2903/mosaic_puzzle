/* Giao diện level editor Color Sort: đổi màu Kit theo Mosaic Studio và định vị hai panel (EditorPanels, StartPopup) */
.ed-root {
    --le-top-h: 32px;
    --le-status-h: 26px;
    --panel: rgb(46, 46, 51);
    --card: rgb(56, 56, 62);
    --card-hi: rgb(66, 66, 74);
    --line: rgb(74, 74, 82);
    --line-hi: rgb(96, 96, 106);
    --field: rgb(31, 31, 36);
    --text: rgb(230, 230, 234);
    --text-dim: rgb(154, 163, 181);
    --text-faint: rgb(154, 163, 181);
    --accent: rgb(250, 204, 21);
    --accent-hi: rgb(253, 224, 71);
    --on-accent: rgb(0, 0, 0);
    --selection: rgba(250, 204, 21, 0.35);
}

.ps-panel {
    position: absolute;
    top: var(--le-top-h);
    bottom: var(--le-status-h);
    padding: 0;
    background-color: var(--panel);
    border-width: 0;
    border-radius: 0;
}

.ps-left { left: 0; width: 300px; max-width: 26%; border-right-width: 1px; border-right-color: var(--line); }
.ps-right { right: 0; width: 300px; max-width: 26%; border-left-width: 1px; border-left-color: var(--line); padding: 12px; }
.ps-left .vk-tabs { flex-grow: 1; }
.ps-left .vk-tab-strip { background-color: rgb(37, 37, 42); }
.ps-left .vk-tab { flex-grow: 1; flex-basis: 0; height: 36px; border-radius: 0; border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); }
.ps-left .vk-tab.vk-on { border-bottom-color: var(--accent); background-color: var(--panel); }
.ps-left .vk-tab-pages { padding: 12px; }
.ps-left .vk-section-head { margin-top: 10px; }

.ps-thumb { height: 140px; border-radius: 5px; background-color: rgba(0, 0, 0, 0); }

.ps-palette { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }

.ps-swatch {
    width: 28px;
    height: 28px;
    margin: 2px;
    padding: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
}

.ps-swatch.ps-on { border-width: 2px; border-color: rgb(255, 255, 255); }

.ps-wrap { flex-direction: row; flex-wrap: wrap; }
.ps-cols { align-items: flex-start; }
.ps-col { flex-grow: 1; flex-basis: 0; min-width: 0; }
.ps-col .vk-btn { margin-bottom: 2px; }
.vk-btn.ps-on { border-width: 2px; border-color: rgb(250, 204, 21); }

.ps-start { min-height: 360px; align-items: flex-start; }
.ps-start-left { width: 200px; flex-shrink: 0; }
.ps-start-hint { -unity-text-align: middle-center; }
.vk-btn.ps-start-btn { height: 40px; -unity-font-style: bold; }
.ps-start-recent { flex-grow: 1; flex-basis: 0; min-width: 0; }
.ps-start-head { align-items: center; }
.ps-start-recent .le-recent-grid { margin-left: -6px; margin-top: -6px; }

.ps-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.ps-left, .ps-right { overflow: hidden; }
.ps-left .vk-tabs, .ps-left .vk-tab-pages, .ps-left .vk-tab-page { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.ps-left .vk-tab-strip { flex-shrink: 0; }
.ps-right { padding: 12px 8px 12px 12px; }

.ps-mech { position: absolute; left: 310px; top: 44px; max-height: 88%; width: 260px; padding: 10px; background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 8px; }
.ps-mrow { align-items: center; padding: 3px 6px; background-color: var(--card); border-radius: 4px; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); }
.ps-mrow.ps-on { border-color: rgb(250, 204, 21); }
.ps-dot { width: 12px; height: 12px; border-radius: 3px; flex-shrink: 0; }
.ps-grow { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.vk-btn.ps-x { width: 22px; padding: 0; }
.vk-btn.ps-chip { flex-direction: row; justify-content: center; align-items: center; }
.ps-badge { margin-left: 4px; padding: 0 4px; border-radius: 6px; }
.ps-count { min-width: 40px; margin: 2px; padding: 4px 6px; border-radius: 4px; -unity-text-align: middle-center; }
.ps-band { position: absolute; background-color: rgba(255, 255, 255, 0.12); border-width: 1px; border-color: rgba(255, 255, 255, 0.63); }
.ps-tip { position: absolute; right: 316px; top: 60px; max-height: 88%; width: 344px; padding: 10px; background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 8px; }
.ps-patterns { flex-direction: row; flex-wrap: wrap; }
.vk-btn.ps-pattern { width: 92px; height: 96px; margin: 2px; padding: 4px; flex-direction: column; align-items: center; justify-content: flex-start; }
.ps-pattern-img { width: 64px; height: 64px; margin-top: 2px; border-radius: 4px; -unity-text-align: middle-center; background-color: var(--field); }

/* tab: chữ không đậm lên khi chọn nên không bị cắt, chia đều ba tab */
.ps-left .vk-tab { padding-left: 2px; padding-right: 2px; -unity-text-align: middle-center; white-space: nowrap; text-overflow: clip; }
.ps-left .vk-tab.vk-on { -unity-font-style: normal; }

/* khoảng đệm trong vùng cuộn của panel */
.ps-scroll .unity-scroll-view__content-container { padding: 4px 4px 12px 4px; }

/* ô số trong inspector phải: giãn hết bề ngang thay vì để một thanh rỗng sau nút + */
.ps-right .vk-stepper { align-self: stretch; }
.ps-right .vk-stepper-field { flex-grow: 1; }

/* hàng thêm hộp trong cột hẹp: ô số co lại nhường chỗ cho nút +, không để nút tràn ra ngoài cột */
.ps-col .vk-stepper { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ps-col .vk-stepper-field { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ps-col .vk-btn { flex-shrink: 0; }

.ps-ghost { position: absolute; padding: 4px 12px; border-radius: 6px; -unity-font-style: bold; opacity: 0.92; border-width: 1px; border-color: rgba(255, 255, 255, 0.6); }
.ps-drop { position: absolute; height: 3px; background-color: rgb(250, 204, 21); border-radius: 2px; }
.ps-pop { position: absolute; width: 224px; padding: 8px; background-color: rgb(38, 38, 44); border-width: 1px; border-color: rgba(255, 255, 255, 0.18); border-radius: 8px; }
.ps-pop .ps-palette { margin-bottom: 6px; }
.ps-trio .vk-btn { flex-grow: 1; flex-basis: 0; min-width: 0; padding-left: 4px; padding-right: 4px; }
.ps-pop-value { flex-grow: 1; -unity-text-align: middle-center; }
