/* Biến màu / cỡ chữ / khoảng cách: chép từ tool editor Bee Flow (010-tokens.uss). Màu riêng của từng màn hình nằm ở file USS của màn đó. */
.ed-root {
    --panel: rgb(36, 39, 47);
    --card: rgb(44, 48, 57);
    --card-hi: rgb(52, 57, 67);
    --line: rgb(60, 66, 78);
    --line-hi: rgb(75, 82, 97);
    --dead: rgb(48, 52, 60);
    --text: rgb(230, 232, 236);
    --text-dim: rgb(182, 189, 201);
    --text-faint: rgb(146, 154, 169);
    --accent: rgb(242, 180, 65);
    --accent-dim: rgb(138, 101, 32);
    --on-accent: rgb(32, 26, 11);
    --ok: rgb(76, 195, 138);
    --warn: rgb(232, 161, 58);
    --danger: rgb(229, 72, 77);
    --danger-bg: rgb(62, 35, 39);
    --danger-bg-hi: rgb(92, 43, 48);
    --danger-text: rgb(255, 146, 149);
    --sep: rgba(255, 255, 255, 0.07);
    --zebra: rgba(255, 255, 255, 0.03);
    --clear: rgba(0, 0, 0, 0);
    --text-strong: rgb(255, 255, 255);
    --field: rgb(24, 26, 31);
    --scrim: rgba(0, 0, 0, 0.72);
    --inset: rgba(0, 0, 0, 0.3);
    --badge-bg: rgba(0, 0, 0, 0.6);
    --swatch-edge: rgba(0, 0, 0, 0.5);
    --float-bg: rgba(20, 22, 27, 0.9);
    --hover-tint: rgba(255, 255, 255, 0.06);
    --edge-on-dark: rgba(255, 255, 255, 0.3);
    --accent-hi: rgb(250, 195, 92);
    --accent-tint: rgba(242, 180, 65, 0.14);
    --selection: rgba(242, 180, 65, 0.35);
    --ok-bg: rgba(76, 195, 138, 0.14);
    --warn-bg: rgba(232, 161, 58, 0.14);
    --danger-tint: rgba(229, 72, 77, 0.14);
    --danger-solid: rgb(126, 52, 56);
    --danger-solid-hi: rgb(158, 63, 68);
    --danger-edge: rgb(196, 92, 96);
    --on-danger-solid: rgb(255, 214, 214);
    --fs-2xs: 10px;
    --fs-xs: 11px;
    --fs-sm: 12px;
    --fs-md: 13px;
    --fs-lg: 14px;
    --fs-xl: 16px;
    --fs-2xl: 18px;
    --sp-1: 2px;
    --sp-2: 4px;
    --sp-3: 6px;
    --sp-4: 8px;
    --sp-5: 12px;
    --sp-6: 16px;
    --r-sm: 3px;
    --r-md: 4px;
    --r-lg: 6px;
    --r-pill: 10px;
    --h-xs: 18px;
    --h-sm: 22px;
    --h-md: 24px;
    --h-lg: 30px;
    --row: 26px;
    --row-lg: 32px;
    --field-tag-w: 88px;
}
